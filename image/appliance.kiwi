<?xml version="1.0" encoding="utf-8"?>
<!--
  Forked from amazonlinux/kiwi-image-descriptions-examples
  (al2023/attestable-image-example, Apache License 2.0).

  Changes from upstream:
    - Renamed the image.
    - config.sh additionally preset-enables nitrotpm-data.service (the baked
      LUKS-enroll/unlock unit). The package set is unchanged: every runtime
      dependency the demo needs (cryptsetup, veritysetup, aws-nitro-tpm-tools,
      systemd-boot, dracut-kiwi-verity, dracut-kiwi-overlay) is already present
      in the upstream recipe, and data-volume discovery-by-exclusion needs no
      extra package (no amazon-ec2-utils, no udev rule).

  This produces an immutable, zero-operator-access AL2023 attestable AMI:
  systemd-boot UKI, dm-verity over the whole root (panic-on-corruption), an
  erofs read-only root with an ephemeral overlay, and no cloud-init / sshd /
  ssm / ec2-instance-connect.
-->
<image schemaversion="7.5" name="al2023-nitrotpm-sealed-ebs">
    <description type="system">
        <author>Richard Fan</author>
        <contact>richardfan1126@gmail.com</contact>
        <specification>AL2023 attestable AMI with a NitroTPM-sealed LUKS data volume</specification>
        <license>Apache License 2.0</license>
    </description>
    <preferences>
        <version>1.0.0</version>
        <packagemanager>dnf</packagemanager>
        <locale>en_US</locale>
        <keytable>us</keytable>
        <timezone>UTC</timezone>
        <rpm-check-signatures>true</rpm-check-signatures>
        <type
            image="oem"
            filesystem="xfs"
            kernelcmdline="console=ttyS0 rd.shell=0 systemd.getty_auto=false rd.kiwi.verity_options=panic-on-corruption"
            firmware="uefi"
            overlayroot="true"
            overlayroot_write_partition="false"
            overlayroot_readonly_filesystem="erofs"
            overlayroot_readonly_partsize="2048"
            erofscompression="lz4hc,level=12"
            eficsm="false"
            verity_blocks="all"
            bootpartition="false"
            efipartsize="200"
            editbootinstall="edit_boot_install.sh">
        <oemconfig>
            <oem-resize>false</oem-resize>
        </oemconfig>
        <bootloader name="systemd_boot" timeout="0"/>
        <initrd action="setup">
            <dracut uefi="true"/>
        </initrd>
        <size unit="G">4</size>
        </type>
    </preferences>

    <repository priority="2" package_gpgcheck="true" sourcetype="mirrorlist" customize="add-gpg-key.sh">
            <source path="https://cdn.amazonlinux.com/al2023/core/mirrors/latest/$basearch/mirror.list"/>
    </repository>

    <packages type="image">
        <!-- Use ami-minimal-kernel6.12 for kernel6.12 images -->
        <namedCollection name="core"/>
        <namedCollection name="ami-minimal"/>
        <package name="pciutils"/>
        <package name="gzip"/>
        <package name="awscli"/>
        <package name="veritysetup"/>
        <package name="systemd-boot"/>
        <package name="tar"/>
        <package name="zram-generator"/>
        <package name="zram-generator-defaults"/>
        <package name="cryptsetup"/>
        <package name="dracut-kiwi-verity"/>
        <package name="dracut-kiwi-overlay"/>
        <package name="aws-nitro-tpm-tools"/>
        <package name="systemd-resolved"/>
        <package name="amazon-chrony-config"/>
        <package name="binutils"/>
        <!-- Don't install these packages -->
        <ignore name="ec2-hibinit-agent"/>
        <ignore name="grubby"/>
        <ignore name="grub2-pc-modules"/>
        <ignore name="grub2-tools"/>
        <ignore name="grub2-efi-aa64-ec2"/>
        <ignore name="grub2-efi-aa64"/>
        <ignore name="grub2-efi-aa64-modules"/>
        <ignore name="grub2-efi-x64-ec2"/>
        <ignore name="grub2-efi-x64"/>
        <ignore name="grub2-efi-x64-modules"/>
        <ignore name="firewalld"/>
        <ignore name="amazon-linux-repo-s3"/>
        <ignore name="amazon-linux-repo-cdn"/>
        <!-- Remove operator access by not installing these packages -->
        <ignore name="openssh-server"/>
        <ignore name="amazon-ssm-agent"/>
        <ignore name="cloud-init"/>
        <ignore name="cloud-init-cfg-ec2"/>
        <ignore name="update-motd" />
        <ignore name="ec2-instance-connect"/>
    </packages>
    <packages type="bootstrap">
        <package name="system-release"/>
        <package name="dnf"/>
        <!-- Ignoring these packages forces the use of the minimal versions -->
        <ignore name="libcurl"/>
        <ignore name="curl"/>
        <ignore name="gnupg2"/>
    </packages>
</image>
